# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of this application.
APP_URL="MY_APP_URL"

# Capital.com Demo Account Credentials (server-side only; never exposed to browser)
# Generate an API key in Capital.com -> Settings -> API Integrations
CAPITAL_DEMO_API_KEY=""
CAPITAL_DEMO_IDENTIFIER=""
CAPITAL_DEMO_PASSWORD=""

# Capital.com Live Account Credentials (server-side only; never exposed to browser)
CAPITAL_LIVE_API_KEY=""
CAPITAL_LIVE_IDENTIFIER=""
CAPITAL_LIVE_PASSWORD=""

# Default startup environment: DEMO or LIVE
CAPITAL_DEFAULT_ENV="DEMO"
